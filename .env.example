# Django REST API — set your server URL before `npm run build`.
# Leave empty for same-origin (/api/...) when Vite/nginx proxies /api/ and /media/ to Django.
# Empty is required for HTTPS local/LAN so the browser does not block mixed content / camera.
VITE_API_BASE_URL=
# Set false to skip ML API calls in the UI (cameras, attendance face, etc.)
VITE_ML_ENABLED=true
